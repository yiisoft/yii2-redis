{
    "name": "yiisoft/yii2-redis",
    "description": "Redis Cache, Session and ActiveRecord for the Yii framework",
    "keywords": ["yii2", "redis", "active-record", "cache", "session"],
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii2-redis/issues",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "source": "https://github.com/yiisoft/yii2-redis"
    },
    "authors": [
        {
            "name": "Carsten Brandt",
            "email": "mail@cebe.cc"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-openssl": "*",
        "yiisoft/yii2": "^22.0@dev",
        "predis/predis": "^3.4"
    },
    "require-dev": {
        "phpunit/phpunit": "9.*",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "yiisoft/yii2-coding-standards": "^3.0"
    },
    "autoload": {
        "psr-4": { "yii\\redis\\": "src" }
    },
    "autoload-dev": {
        "psr-4": {
            "yiiunit\\extensions\\redis\\": "tests/",
            "yiiunit\\extensions\\predis\\": "tests/predis/"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "cs": "./vendor/bin/phpcs",
        "cs-fix": "./vendor/bin/phpcbf",
        "static": "./vendor/bin/phpstan --memory-limit=-1",
        "tests": "./vendor/bin/phpunit"
    }
}
